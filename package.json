{
  "name": "astral.js",
  "version": "1.2.0",
  "description": "Astral.js is a lightweight UI toolkit designed to empower JavaScript developers with powerful tools for building modern user interfaces. With Astral.js, you gain access to a comprehensive set of features including context and state management, event-driven architecture, and sophisticated JavaScript-powered media queries.",
  "main": "src/index.js",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "docs": "typedoc --entryPointStrategy expand ./src --exclude \"./src/index.ts\"",
    "build": "webpack --config webpack.conf.js",
    "build:dev": "webpack --config webpack.conf.js --mode development",
    "build:prod": "webpack --config webpack.conf.js --mode production",
    "build:analyze": "webpack --config webpack.conf.js --profile --json > stats.json",
    "analyze": "webpack-bundle-analyzer dist/stats.json",
    "lint": "eslint src/**/*.ts --fix",
    "format": "prettier --write \"{src/**/*.ts,specs/*.js,specs/*.ts}\"",
    "prepare": "husky install"
  },
  "repository": "git+https://github.com/rabisnaqvi/Astral.js.git",
  "keywords": [
    "ui",
    "toolkit",
    "lightweight",
    "javascript",
    "context",
    "management",
    "state",
    "management",
    "state management",
    "media queries",
    "event-driven",
    "architecture",
    "media",
    "queries",
    "responsive",
    "design",
    "user",
    "interface",
    "front-end",
    "development",
    "web",
    "development",
    "open",
    "source",
    "utility",
    "functions",
    "performance",
    "optimization",
    "modern",
    "JavaScript"
  ],
  "author": "Rabis Naqvi",
  "license": "MIT",
  "engines": {
    "node": "20.18.0"
  },
  "bugs": {
    "url": "https://github.com/rabisnaqvi/Astral.js/issues"
  },
  "homepage": "https://github.com/rabisnaqvi/Astral.js#readme",
  "devDependencies": {
    "@babel/preset-env": "^7.22.0",
    "@babel/preset-typescript": "^7.21.5",
    "@typescript-eslint/eslint-plugin": "^5.59.7",
    "@typescript-eslint/parser": "^5.59.7",
    "babel-jest": "^29.5.0",
    "compression-webpack-plugin": "^10.0.0",
    "eslint": "^8.41.0",
    "eslint-plugin-import": "^2.27.5",
    "eslint-plugin-prettier": "^4.2.1",
    "husky": "^9.0.11",
    "jest": "^29.5.0",
    "jest-environment-jsdom": "^29.5.0",
    "lint-staged": "^15.2.2",
    "path": "^0.12.7",
    "prettier": "^2.8.8",
    "terser-webpack-plugin": "^5.3.14",
    "ts-loader": "^9.4.3",
    "typedoc": "^0.24.7",
    "typescript": "^5.0.4",
    "webpack": "^5.83.1",
    "webpack-bundle-analyzer": "^4.10.2",
    "webpack-cli": "^5.1.1"
  },
  "lint-staged": {
    "*.{ts,js}": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
